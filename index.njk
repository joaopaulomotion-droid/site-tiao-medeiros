        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{{ site.footer.copyright }}</span>
      <span>{{ site.footer.cargo_line }}</span>
    </div>
  </div>
</footer>

<script>
// Nav scroll state
const nav = document.getElementById('siteNav');
window.addEventListener('scroll', () => {
  nav.classList.toggle('scrolled', window.scrollY > 40);
}, {passive:true});

// Mobile nav toggle
const navToggle = document.getElementById('navToggle');
const navLinks = document.getElementById('navLinks');
navToggle.addEventListener('click', () => {
  navLinks.classList.toggle('open');
});
navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => navLinks.classList.remove('open')));

// Reveal on scroll
const revealEls = document.querySelectorAll('.reveal');
const io = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('in');
      io.unobserve(entry.target);
    }
  });
}, {threshold:0.15});
revealEls.forEach(el => io.observe(el));

/* ============ MODAL PAUTAS E VALORES ============ */
(function(){
  const overlay = document.getElementById('pautaModalOverlay');
  if (!overlay) return;
  const panels = overlay.querySelectorAll('.pauta-modal-panel');
  const cards = document.querySelectorAll('.pauta-card[data-pauta-target]');
  let lastFocused = null;

  function openPauta(key){
    let found = false;
    panels.forEach(p => {
      const match = p.getAttribute('data-pauta-panel') === key;
      p.classList.toggle('active', match);
      if (match) found = true;
    });
    if (!found) return;
    lastFocused = document.activeElement;
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.classList.add('pauta-modal-active');
    const closeBtn = overlay.querySelector('.pauta-modal-panel.active .pauta-modal-close');
    if (closeBtn) closeBtn.focus();
  }
  function closePauta(){
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('pauta-modal-active');
    if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
  }

  cards.forEach(card => {
    card.addEventListener('click', () => {
      openPauta(card.getAttribute('data-pauta-target'));
    });
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openPauta(card.getAttribute('data-pauta-target'));
      }
    });
  });
  overlay.querySelectorAll('[data-modal-close]').forEach(btn => btn.addEventListener('click', closePauta));
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closePauta(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('open')) closePauta();
  });
})();

/* ============ CAPA DE VÍDEO (YOUTUBE FACADE) ============ */
document.querySelectorAll('.yt-facade').forEach(el => {
  function playVideo(){
    const id = el.getAttribute('data-yt-id');
    const iframe = document.createElement('iframe');
    iframe.src = 'https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0';
    iframe.title = el.getAttribute('aria-label') || 'Vídeo';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
    el.replaceWith(iframe);
  }
  el.addEventListener('click', playVideo);
});

/* ============ MODAL TRAJETÓRIA ============ */
(function(){
  const overlay = document.getElementById('tlModalOverlay');
  if (!overlay) return;
  const panels = overlay.querySelectorAll('.pauta-modal-panel');
  const cards = document.querySelectorAll('.tl-item[data-tl-target]');
  let lastFocused = null;

  function openTl(key){
    let found = false;
    panels.forEach(p => {
      const match = p.getAttribute('data-tl-panel') === key;
      p.classList.toggle('active', match);
      if (match) found = true;
    });
    if (!found) return;
    lastFocused = document.activeElement;
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.classList.add('pauta-modal-active');
    const closeBtn = overlay.querySelector('.pauta-modal-panel.active .pauta-modal-close');
    if (closeBtn) closeBtn.focus();
  }
  function closeTl(){
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('pauta-modal-active');
    if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
  }

  cards.forEach(card => {
    card.addEventListener('click', () => {
      openTl(card.getAttribute('data-tl-target'));
    });
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openTl(card.getAttribute('data-tl-target'));
      }
    });
  });
  overlay.querySelectorAll('[data-tl-modal-close]').forEach(btn => btn.addEventListener('click', closeTl));
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeTl(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('open')) closeTl();
  });
})();

/* ============ NAVEGAÇÃO DA TIMELINE ============ */
(function(){
  const scrollWrap = document.getElementById('timelineScroll');
  const track = document.getElementById('timelineTrack');
  const prevBtn = document.getElementById('tlPrev');
  const nextBtn = document.getElementById('tlNext');
  const progressFill = document.getElementById('tlProgressFill');
  if (!track) return;

  function cardStep(){
    const first = track.querySelector('.tl-item');
    if (!first) return 260;
    const style = getComputedStyle(track);
    const gap = parseFloat(style.columnGap || style.gap || '20') || 20;
    return first.getBoundingClientRect().width + gap;
  }
  function updateState(){
    const maxScroll = track.scrollWidth - track.clientWidth;
    const atStart = track.scrollLeft <= 4;
    const atEnd = maxScroll <= 4 || track.scrollLeft >= maxScroll - 4;
    if (scrollWrap) {
      scrollWrap.classList.toggle('at-start', atStart);
      scrollWrap.classList.toggle('at-end', atEnd);
    }
    if (prevBtn) prevBtn.disabled = atStart;
    if (nextBtn) nextBtn.disabled = atEnd;
    if (progressFill) {
      const ratio = maxScroll > 0 ? Math.min(1, Math.max(0, track.scrollLeft / maxScroll)) : 0;
      const track2Width = track.clientWidth / track.scrollWidth;
      const fillPct = Math.max(track2Width, ratio * (1 - track2Width) + track2Width) * 100;
      progressFill.style.width = fillPct + '%';
    }
  }
  if (prevBtn) prevBtn.addEventListener('click', () => track.scrollBy({left: -cardStep() * 2, behavior: 'smooth'}));
  if (nextBtn) nextBtn.addEventListener('click', () => track.scrollBy({left: cardStep() * 2, behavior: 'smooth'}));
  track.addEventListener('scroll', updateState, {passive: true});
  window.addEventListener('resize', updateState);
  updateState();
})();
</script>
</body>
</html>
