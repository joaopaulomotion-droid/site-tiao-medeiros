<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site.meta.title }}</title>
<meta name="description" content="{{ site.meta.description }}">
<meta name="author" content="Tião Medeiros">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:title" content="{{ site.meta.title }}">
<meta property="og:description" content="{{ site.meta.description }}">
<meta property="og:locale" content="pt_BR">

<!-- Schema.org -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "GovernmentOfficial",
  "name": "Tião Medeiros",
  "jobTitle": "Deputado Federal",
  "worksFor": {
    "@type": "GovernmentOrganization",
    "name": "Câmara dos Deputados do Brasil"
  },
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "PR",
    "addressCountry": "BR"
  }
}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,500&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet">

<style>
/* ===================== TOKENS ===================== */
:root{
  --blue-deep:#0f2350;
  --blue:#274994;
  --blue-mid:#3a5cad;
  --blue-light:#5dcbfa;
  --yellow:#f9da49;
  --yellow-deep:#e0b91f;
  --green:#4fae4a;
  --ink:#12203a;
  --ink-soft:#48566f;
  --paper:#f6f8fc;
  --paper-deep:#eef1f8;
  --white:#ffffff;
  --line:#e1e6f0;

  --display:'Libre Franklin', sans-serif;
  --label:'Barlow Condensed', sans-serif;

  --maxw:1180px;
  --radius:18px;
  --ease:cubic-bezier(.2,.8,.2,1);
}

*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  margin:0;
  font-family:var(--display);
  color:var(--ink);
  background:var(--white);
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
img{max-width:100%;display:block;}
a{text-decoration:none;color:inherit;}
ul{margin:0;padding:0;list-style:none;}
button{font-family:inherit;cursor:pointer;}
h1,h2,h3,p{margin:0;}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 28px;}

@media (prefers-reduced-motion: reduce){
  *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; scroll-behavior:auto !important;}
}

/* focus visibility */
a:focus-visible,button:focus-visible{outline:3px solid var(--blue-light);outline-offset:3px;border-radius:4px;}

/* ===================== EYEBROW / LABEL UTILITY ===================== */
.eyebrow{
  font-family:var(--label);
  font-weight:600;
  letter-spacing:.14em;
  text-transform:uppercase;
  font-size:14px;
  color:var(--blue);
  display:inline-flex;
  align-items:center;
  gap:10px;
}
.eyebrow::before{
  content:"";
  width:26px;height:2px;background:var(--yellow-deep);
  display:inline-block;
}
.eyebrow.on-dark{color:var(--yellow);}
.eyebrow.on-dark::before{background:var(--yellow);}

/* ===================== REVEAL ANIMATION ===================== */
.reveal{opacity:0;transform:translateY(28px);transition:opacity .8s var(--ease), transform .8s var(--ease);}
.reveal.in{opacity:1;transform:translateY(0);}
.reveal-d1{transition-delay:.08s;}
.reveal-d2{transition-delay:.16s;}
.reveal-d3{transition-delay:.24s;}
.reveal-d4{transition-delay:.32s;}

/* ===================== NAV ===================== */
.nav{
  position:fixed;top:0;left:0;right:0;z-index:1000;
  padding:18px 0;
  transition:background .35s var(--ease), padding .35s var(--ease), box-shadow .35s var(--ease);
}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;gap:24px;}
.nav.scrolled{
  background:rgba(255,255,255,.92);
  backdrop-filter:blur(10px);
  padding:11px 0;
  box-shadow:0 8px 24px rgba(15,35,80,.08);
}
.nav-logo{display:flex;align-items:center;gap:10px;}
.nav-logo img{height:44px;width:auto;transition:height .35s var(--ease);}
.nav.scrolled .nav-logo img{height:36px;}
.nav-links{display:flex;align-items:center;gap:30px;}
.nav-links a{
  font-family:var(--label);
  font-weight:600;
  letter-spacing:.03em;
  font-size:16px;
  color:var(--white);
  position:relative;
  padding:4px 0;
  transition:color .3s var(--ease);
}
.nav.scrolled .nav-links a{color:var(--ink);}
.nav-links a::after{
  content:"";position:absolute;left:0;bottom:-2px;height:2px;width:0;background:var(--yellow-deep);
  transition:width .3s var(--ease);
}
.nav-links a:hover::after{width:100%;}
.nav-cta{
  font-family:var(--label);font-weight:700;letter-spacing:.03em;font-size:15px;
  background:var(--yellow);color:var(--blue-deep);
  padding:11px 22px;border-radius:999px;
  box-shadow:0 6px 18px rgba(249,218,73,.35);
  transition:transform .3s var(--ease), box-shadow .3s var(--ease);
  white-space:nowrap;
}
.nav-cta:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(249,218,73,.45);}
.nav-toggle{display:none;background:none;border:none;padding:8px;}
.nav-toggle span{display:block;width:26px;height:2px;background:var(--white);margin:5px 0;transition:.3s;}
.nav.scrolled .nav-toggle span{background:var(--ink);}

@media (max-width:920px){
  .nav-links{
    position:fixed;inset:0;z-index:1000;
    background:var(--blue-deep);
    flex-direction:column;justify-content:center;align-items:flex-start;
    padding:100px 40px 40px;gap:24px;
    overflow-y:auto;
    transform:translateX(100%);transition:transform .4s var(--ease);
  }
  .nav-links.open{transform:translateX(0);}
  .nav-links a{color:var(--white) !important;font-size:22px;}
  .nav-toggle{display:block;z-index:1001;}
  .nav-links .nav-cta{
    display:inline-flex;margin-top:10px;
    background:var(--yellow) !important;color:var(--blue-deep) !important;
    font-size:16px !important;padding:14px 26px !important;border-radius:999px;
  }
}

/* ===================== HERO ===================== */
.hero{
  position:relative;
  min-height:100vh;
  display:flex;align-items:center;
  background:linear-gradient(155deg, var(--blue-deep) 0%, var(--blue) 62%, var(--blue-mid) 100%);
  overflow:hidden;
  padding:150px 0 90px;
}
.hero-bg-pattern{
  position:absolute;inset:0;
  background-image:radial-gradient(rgba(255,255,255,.07) 1.5px, transparent 1.5px);
  background-size:26px 26px;
  opacity:.5;
  mask-image:linear-gradient(180deg, transparent, black 30%, black 70%, transparent);
}
.hero-sash{
  position:absolute;top:-120px;right:-160px;width:620px;height:620px;
  background:conic-gradient(from 200deg, var(--yellow) 0deg 8deg, transparent 8deg 360deg);
  border-radius:50%;
  opacity:.9;
  filter:blur(0px);
}
.hero .wrap{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;text-align:center;}
.hero-eyebrow-row{display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:22px;flex-wrap:wrap;}
.hero h1{
  font-size:clamp(34px,4.6vw,58px);
  line-height:1.08;
  font-weight:800;
  color:var(--white);
  letter-spacing:-.01em;
  margin-bottom:22px;
  max-width:900px;
}
.hero h1 em{
  font-style:normal;color:var(--yellow);
  background:linear-gradient(180deg, transparent 68%, rgba(249,218,73,.35) 68%);
}
.hero p.lead{
  font-size:18px;line-height:1.65;color:rgba(255,255,255,.86);
  max-width:640px;margin:0 auto 34px;font-weight:400;
}
.hero-ctas{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;margin-bottom:46px;}
.btn{
  font-family:var(--label);font-weight:700;letter-spacing:.03em;font-size:16px;
  padding:15px 30px;border-radius:999px;border:2px solid transparent;
  display:inline-flex;align-items:center;gap:10px;
  transition:transform .3s var(--ease), box-shadow .3s var(--ease), background .3s var(--ease), color .3s var(--ease);
}
.btn-primary{background:var(--yellow);color:var(--blue-deep);box-shadow:0 10px 26px rgba(249,218,73,.3);}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 14px 32px rgba(249,218,73,.4);}
.btn-ghost{border-color:rgba(255,255,255,.5);color:var(--white);}
.btn-ghost:hover{background:rgba(255,255,255,.12);border-color:var(--white);transform:translateY(-3px);}
.btn-ghost svg{transition:transform .3s var(--ease);}
.btn-ghost:hover svg{transform:scale(1.15);}

.hero-trust{display:flex;align-items:center;justify-content:center;gap:18px;flex-wrap:wrap;margin-top:36px;}
.flag-pin{width:40px;height:40px;border-radius:50%;box-shadow:0 4px 10px rgba(0,0,0,.25);border:2px solid rgba(255,255,255,.5);overflow:hidden;flex:none;}
.hero-trust-text{font-size:14px;color:rgba(255,255,255,.75);line-height:1.4;}
.hero-trust-text strong{color:var(--white);display:block;font-size:15px;}
.trust-divider{width:1px;height:34px;background:rgba(255,255,255,.25);}
.legisla-chip{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.25);
  padding:9px 16px 9px 10px;border-radius:999px;
  font-size:13px;color:var(--white);
}
.legisla-chip .dot{width:9px;height:9px;border-radius:50%;background:var(--yellow);box-shadow:0 0 0 4px rgba(249,218,73,.25);}

.hero-photo-frame{position:relative;width:100%;max-width:980px;margin:44px auto 0;}
.hero-photo-card{
  position:relative;border-radius:28px;overflow:hidden;
  aspect-ratio:16/9;
  background:linear-gradient(145deg, var(--blue-light), var(--blue-mid) 60%, var(--blue-deep));
  display:flex;align-items:center;justify-content:center;
  border:6px solid rgba(255,255,255,.14);
  box-shadow:0 30px 60px rgba(6,16,42,.45);
}
.hero-photo-card iframe{position:absolute;inset:0;width:100%;height:100%;border:0;}
.hero-photo-card .hero-video-placeholder{
  position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;color:var(--white);text-align:center;padding:0 20px;
}
.hero-photo-card .hero-video-placeholder span{font-family:var(--label);font-size:13px;letter-spacing:.05em;color:rgba(255,255,255,.65);}
.hero-photo-card .ph-icon{width:34%;opacity:.5;}
.img-slot{position:relative;}
.img-slot .slot-content{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;}
.slot-img{width:100%;height:100%;object-fit:contain;object-position:bottom center;position:relative;z-index:1;}
.slot-edit-btn{
  display:none;position:absolute;left:50%;bottom:20px;transform:translateX(-50%);
  font-family:var(--label);font-weight:700;font-size:13px;letter-spacing:.03em;
  background:var(--white);color:var(--blue-deep);border:none;
  padding:10px 18px;border-radius:999px;box-shadow:0 10px 24px rgba(6,16,42,.3);
  z-index:5;
}
body.edit-mode .img-slot{outline:2px dashed rgba(255,255,255,.5);outline-offset:-2px;}
body.edit-mode .slot-edit-btn{display:inline-flex;}
.hero-photo-note{
  position:absolute;bottom:-22px;left:-22px;
  background:var(--white);color:var(--ink);
  padding:16px 20px;border-radius:16px;
  box-shadow:0 16px 34px rgba(6,16,42,.25);
  font-family:var(--label);font-size:14px;line-height:1.3;
  max-width:220px;
}
.hero-photo-note strong{display:block;font-size:20px;color:var(--blue);font-family:var(--display);}
.hero-photo-accent{
  position:absolute;top:-18px;right:-18px;
  background:var(--yellow);width:88px;height:88px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 14px 28px rgba(249,218,73,.4);
  animation:spin 18s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg);}}

.scroll-cue{
  position:absolute;bottom:26px;left:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:8px;
  color:rgba(255,255,255,.6);font-family:var(--label);font-size:12px;letter-spacing:.16em;text-transform:uppercase;
  z-index:2;
}
.scroll-cue .line{width:1px;height:34px;background:rgba(255,255,255,.4);position:relative;overflow:hidden;}
.scroll-cue .line::after{content:"";position:absolute;top:-100%;left:0;width:100%;height:100%;background:var(--yellow);animation:scrolldown 1.8s infinite;}
@keyframes scrolldown{0%{top:-100%;}60%{top:100%;}100%{top:100%;}}

@media (max-width:980px){
  .hero{padding:130px 0 70px;min-height:0;}
}
@media (max-width:560px){
  .hero{padding:110px 0 60px;}
  .hero-sash{display:none;}
  .hero-photo-frame{margin:28px auto 0;}
  .hero-photo-note{position:static;max-width:none;margin-top:14px;text-align:center;}
  .hero-photo-accent{display:none;}
  .scroll-cue{display:none;}
}

/* ===================== SECTION SHELL ===================== */
.section{padding:110px 0;position:relative;}
.section-paper{background:var(--paper);}
.section-head{max-width:640px;margin-bottom:56px;}
.section-head h2{
  font-size:clamp(28px,3.6vw,42px);
  font-weight:800;line-height:1.14;letter-spacing:-.01em;
  margin-top:14px;color:var(--ink);
}
.section-head p{margin-top:16px;font-size:17px;line-height:1.6;color:var(--ink-soft);}
@media (max-width:720px){.section{padding:76px 0;}}

/* ===================== SOBRE ===================== */
.about-grid{display:grid;grid-template-columns:.92fr 1.08fr;gap:64px;align-items:center;}
.about-photo{
  position:relative;border-radius:24px;overflow:hidden;aspect-ratio:3/4;
  background:linear-gradient(160deg, var(--blue) 0%, var(--blue-deep) 100%);
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 24px 50px rgba(15,35,80,.18);
}
.about-photo .ph-icon{width:32%;opacity:.45;}
.about-photo-tag{
  position:absolute;left:20px;bottom:20px;
  background:rgba(255,255,255,.94);backdrop-filter:blur(6px);
  padding:10px 16px;border-radius:12px;
  font-family:var(--label);font-size:13px;color:var(--blue-deep);font-weight:600;letter-spacing:.02em;
}
.about-text p{font-size:17px;line-height:1.85;color:var(--ink-soft);margin-bottom:18px;}
.about-badges{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px;}
.about-badge{
  font-family:var(--label);font-weight:600;font-size:14px;letter-spacing:.02em;
  background:var(--white);border:1px solid var(--line);color:var(--blue);
  padding:9px 16px;border-radius:999px;
}
@media (max-width:900px){.about-grid{grid-template-columns:1fr;}.about-photo{max-width:340px;}}

/* ===================== TIMELINE ===================== */
.timeline-scroll{position:relative;padding:0 54px;}
.tl-viewport{position:relative;overflow:hidden;border-radius:24px;}
.tl-viewport::before,
.tl-viewport::after{
  content:"";position:absolute;top:0;bottom:0;width:56px;z-index:3;pointer-events:none;
  transition:opacity .3s var(--ease);
}
.tl-viewport::before{left:0;background:linear-gradient(90deg, var(--paper) 0%, transparent 100%);}
.tl-viewport::after{right:0;background:linear-gradient(270deg, var(--paper) 0%, transparent 100%);}
.timeline-scroll.at-start .tl-viewport::before{opacity:0;}
.timeline-scroll.at-end .tl-viewport::after{opacity:0;}
.timeline{
  display:flex;gap:20px;overflow-x:auto;padding:6px 4px 6px;
  scroll-snap-type:x mandatory;scroll-behavior:smooth;
  scrollbar-width:none;-ms-overflow-style:none;
}
.timeline::-webkit-scrollbar{display:none;}
.tl-item{
  flex:0 0 232px;scroll-snap-align:start;position:relative;
  border-radius:20px;overflow:hidden;
  background:linear-gradient(165deg, var(--blue) 0%, var(--blue-deep) 100%);
  box-shadow:0 14px 30px rgba(15,35,80,.14);
  transition:transform .4s var(--ease), box-shadow .4s var(--ease);
}
.tl-item{cursor:pointer;}
.tl-item:hover{transform:translateY(-6px);box-shadow:0 22px 46px rgba(15,35,80,.24);}
.tl-item:focus-visible{outline:3px solid var(--blue-light);outline-offset:3px;}
.tl-media{position:relative;aspect-ratio:3/4;}
.tl-media .slot-content{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;}
.tl-media .ph-icon{width:32%;opacity:.4;}
.tl-media .slot-img{width:100%;height:100%;object-fit:cover;position:relative;z-index:0;}
.tl-media::after{
  content:"";position:absolute;inset:0;
  background:linear-gradient(180deg, rgba(15,35,80,0) 35%, rgba(8,17,42,.88) 100%);
}
body.edit-mode .tl-media{outline:2px dashed rgba(255,255,255,.5);outline-offset:-2px;}
body.edit-mode .tl-media .slot-edit-btn{display:inline-flex;}
.tl-body{position:absolute;left:0;right:0;bottom:0;z-index:2;padding:16px 18px 18px;}
.tl-num{font-family:var(--label);font-size:12.5px;color:var(--yellow);font-weight:700;letter-spacing:.1em;}
.tl-title{font-weight:700;font-size:16.5px;margin-top:5px;color:var(--white);line-height:1.28;}
.tl-nav{
  position:absolute;top:50%;transform:translateY(-50%);z-index:4;
  width:44px;height:44px;border-radius:50%;border:none;
  background:var(--white);color:var(--blue-deep);
  display:flex;align-items:center;justify-content:center;cursor:pointer;
  box-shadow:0 10px 24px rgba(15,35,80,.22);transition:transform .25s var(--ease), box-shadow .25s var(--ease), opacity .25s var(--ease);
}
.tl-nav:hover{transform:translateY(-50%) scale(1.08);box-shadow:0 14px 30px rgba(15,35,80,.3);}
.tl-nav-prev{left:0;}
.tl-nav-next{right:0;}
.tl-nav[disabled]{opacity:.35;cursor:default;pointer-events:none;}
.tl-progress{height:5px;background:var(--line);border-radius:5px;margin-top:22px;overflow:hidden;}
.tl-progress-fill{height:100%;width:25%;border-radius:5px;background:linear-gradient(90deg, var(--blue-light), var(--yellow));transition:width .15s linear;}
@media (max-width:720px){
  .timeline-scroll{padding:0 4px;}
  .tl-nav{display:none;}
  .tl-viewport::before,.tl-viewport::after{width:26px;}
  .tl-item{flex:0 0 190px;}
}

/* ===================== OBRAS ===================== */
.stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:44px;}
.stat-card{
  background:var(--white);border:1px solid var(--line);border-radius:16px;padding:26px 22px;text-align:center;
}
.stat-card .stat-num{font-size:32px;font-weight:800;color:var(--blue);font-family:var(--label);}
.stat-card .stat-label{font-size:13px;color:var(--ink-soft);margin-top:6px;font-weight:500;}
.stat-card .stat-placeholder{font-size:11px;color:#b7bfd0;margin-top:8px;font-style:italic;}
.obras-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
.obra-card{
  background:var(--white);border:1.5px dashed var(--line);border-radius:18px;
  padding:30px 24px;min-height:230px;display:flex;flex-direction:column;justify-content:space-between;
  transition:border-color .3s var(--ease), transform .3s var(--ease);
}
.obra-card:hover{border-color:var(--blue-light);transform:translateY(-4px);}
.obra-icon{width:46px;height:46px;border-radius:12px;background:var(--paper-deep);display:flex;align-items:center;justify-content:center;color:var(--blue);}
.obra-card h3{font-size:16px;margin-top:18px;color:var(--ink);}
.obra-card p{font-size:13.5px;color:#9aa3b8;margin-top:8px;font-style:italic;}
@media (max-width:900px){.stats-row,.obras-grid{grid-template-columns:1fr 1fr;}}
@media (max-width:600px){.stats-row,.obras-grid{grid-template-columns:1fr;}}

/* ===================== PAUTAS ===================== */
.pautas-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;}
.pauta-card{
  background:var(--white);border:1px solid var(--line);border-radius:18px;padding:30px 24px;
  transition:transform .35s var(--ease), box-shadow .35s var(--ease), border-color .35s var(--ease);
  position:relative;overflow:hidden;
}
.pauta-card::before{
  content:"";position:absolute;top:0;left:0;width:100%;height:4px;background:var(--blue-light);
  transform:scaleX(0);transform-origin:left;transition:transform .4s var(--ease);
}
.pauta-card:hover{transform:translateY(-6px);box-shadow:0 20px 40px rgba(15,35,80,.1);border-color:transparent;}
.pauta-card:hover::before{transform:scaleX(1);}
.pauta-icon{width:50px;height:50px;border-radius:14px;background:var(--blue);color:var(--white);display:flex;align-items:center;justify-content:center;margin-bottom:20px;}
.pauta-card h3{font-size:16.5px;font-weight:700;margin-bottom:10px;line-height:1.3;}
.pauta-card p{font-size:14.5px;line-height:1.55;color:var(--ink-soft);}
.pauta-card{cursor:pointer;}
.pauta-card:focus-visible{outline:3px solid var(--blue-light);outline-offset:3px;}
.pauta-more{
  display:inline-flex;align-items:center;gap:6px;margin-top:16px;
  font-family:var(--label);font-weight:700;font-size:13.5px;letter-spacing:.02em;color:var(--blue);
}
.pauta-more svg{transition:transform .3s var(--ease);}
.pauta-card:hover .pauta-more svg{transform:translateX(4px);}
@media (max-width:980px){.pautas-grid{grid-template-columns:1fr 1fr;}}
@media (max-width:560px){.pautas-grid{grid-template-columns:1fr;}}

/* ===================== MODAL DE PAUTAS ===================== */
.pauta-modal-overlay{
  position:fixed;inset:0;z-index:3000;
  display:flex;align-items:center;justify-content:center;padding:24px;
  background:rgba(10,18,40,.62);backdrop-filter:blur(6px);
  opacity:0;pointer-events:none;transition:opacity .35s var(--ease);
}
.pauta-modal-overlay.open{opacity:1;pointer-events:auto;}
body.pauta-modal-active{overflow:hidden;}
.pauta-modal-panel{
  display:none;width:100%;max-width:920px;max-height:88vh;overflow-y:auto;
  background:var(--white);border-radius:26px;
  grid-template-columns:.85fr 1.15fr;
  box-shadow:0 40px 90px rgba(6,14,36,.45);
  transform:translateY(24px) scale(.97);opacity:0;
  transition:transform .4s var(--ease), opacity .4s var(--ease);
}
.pauta-modal-panel.active{display:grid;}
.pauta-modal-overlay.open .pauta-modal-panel.active{transform:translateY(0) scale(1);opacity:1;}
.pauta-modal-photo{
  position:relative;min-height:240px;
  background:linear-gradient(160deg, var(--blue) 0%, var(--blue-deep) 100%);
  display:flex;align-items:center;justify-content:center;
  border-radius:26px 0 0 26px;overflow:hidden;
}
.pauta-modal-photo .ph-icon{width:30%;opacity:.4;}
.pauta-modal-photo .slot-content{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;}
body.edit-mode .pauta-modal-photo{outline:2px dashed rgba(255,255,255,.5);outline-offset:-2px;}
body.edit-mode .pauta-modal-photo .slot-edit-btn{display:inline-flex;}
.pauta-modal-body{padding:44px 44px 44px 38px;position:relative;}
.pauta-modal-body h3{font-size:clamp(22px,2.6vw,28px);font-weight:800;margin:14px 0 18px;line-height:1.2;color:var(--ink);}
.pauta-modal-body p{font-size:15.5px;line-height:1.75;color:var(--ink-soft);margin-bottom:14px;}
.pauta-modal-close{
  position:absolute;top:18px;right:18px;z-index:5;
  width:38px;height:38px;border-radius:50%;border:none;
  background:rgba(255,255,255,.92);color:var(--ink);
  display:flex;align-items:center;justify-content:center;cursor:pointer;
  font-size:20px;line-height:1;box-shadow:0 8px 18px rgba(6,14,36,.25);
  transition:transform .25s var(--ease);
}
.pauta-modal-close:hover{transform:scale(1.08);}
@media (max-width:760px){
  .pauta-modal-panel{grid-template-columns:1fr;max-height:92vh;}
  .pauta-modal-photo{min-height:200px;border-radius:26px 26px 0 0;}
  .pauta-modal-body{padding:32px 26px;}
}

/* ===================== PROJETOS ===================== */
.projetos-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px;}
.projeto-card{
  background:var(--white);border:1px solid var(--line);border-radius:18px;padding:28px;
  display:flex;flex-direction:column;gap:14px;
  transition:transform .3s var(--ease), box-shadow .3s var(--ease);
}
.projeto-card:hover{transform:translateY(-4px);box-shadow:0 18px 36px rgba(15,35,80,.09);}
.projeto-top{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;}
.projeto-tag{
  font-family:var(--label);font-weight:700;font-size:14px;letter-spacing:.03em;
  color:var(--white);background:var(--blue);padding:6px 12px;border-radius:8px;white-space:nowrap;
}
.relator-seal{
  font-family:var(--label);font-weight:700;font-size:12px;letter-spacing:.08em;
  color:var(--blue-deep);background:var(--yellow);padding:6px 12px;border-radius:8px;
  display:none;
}
.projeto-card[data-relator="true"] .relator-seal{display:inline-block;}
.projeto-card h3{font-size:18px;font-weight:700;line-height:1.3;}
.projeto-card p{font-size:14.5px;line-height:1.6;color:var(--ink-soft);flex:1;}
.projeto-link{
  font-family:var(--label);font-weight:700;font-size:14px;letter-spacing:.02em;
  color:var(--blue);display:inline-flex;align-items:center;gap:6px;
}
.projeto-link svg{transition:transform .3s var(--ease);}
.projeto-link:hover svg{transform:translateX(4px);}
.projeto-card--wide{
  grid-column:1/-1;
  flex-direction:row;
  align-items:center;
  gap:32px;
}
.projeto-card--wide .projeto-top{flex-direction:column;align-items:flex-start;gap:10px;flex:0 0 140px;}
.projeto-card--wide h3{flex:0 0 300px;}
.projeto-card--wide p{flex:1;margin:0;}
.projeto-card--wide .projeto-link{flex:0 0 auto;}
@media (max-width:800px){
  .projetos-grid{grid-template-columns:1fr;}
  .projeto-card--wide{flex-direction:column;align-items:stretch;}
  .projeto-card--wide .projeto-top,.projeto-card--wide h3{flex:none;}
}

/* ===================== RECONHECIMENTO ===================== */
.reco{
  background:linear-gradient(160deg, var(--blue-deep), var(--blue) 70%);
  border-radius:32px;padding:70px 60px;color:var(--white);
  display:grid;grid-template-columns:auto 1fr;gap:52px;align-items:center;
  position:relative;overflow:hidden;
}
.reco::after{
  content:"";position:absolute;right:-80px;top:-80px;width:280px;height:280px;border-radius:50%;
  background:radial-gradient(circle, rgba(249,218,73,.18), transparent 70%);
}
.reco-medal{
  width:150px;height:150px;border-radius:50%;
  background:conic-gradient(var(--yellow), var(--yellow-deep), var(--yellow));
  display:flex;align-items:center;justify-content:center;flex:none;position:relative;
  box-shadow:0 20px 50px rgba(249,218,73,.3);
}
.reco-medal-inner{
  width:118px;height:118px;border-radius:50%;background:var(--blue-deep);
  display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--yellow);
  font-family:var(--label);
}
.reco-medal-inner .big{font-size:30px;font-weight:700;line-height:1;}
.reco-medal-inner .small{font-size:11px;letter-spacing:.08em;margin-top:4px;}
.reco h2{font-size:clamp(24px,3vw,34px);font-weight:800;line-height:1.2;}
.reco p{margin-top:14px;font-size:16px;line-height:1.7;color:rgba(255,255,255,.85);max-width:600px;}
@media (max-width:780px){.reco{grid-template-columns:1fr;text-align:center;padding:50px 30px;}.reco-medal{margin:0 auto;}}

/* ===================== VIDEO ===================== */
.video-shell{
  position:relative;border-radius:24px;overflow:hidden;aspect-ratio:16/9;
  background:linear-gradient(160deg, var(--blue) 0%, var(--blue-deep) 100%);
  box-shadow:0 30px 60px rgba(15,35,80,.2);
}
.video-shell iframe{position:absolute;inset:0;width:100%;height:100%;border:0;}
.yt-facade{position:absolute;inset:0;cursor:pointer;background:#000;border:0;padding:0;width:100%;height:100%;display:block;}
.yt-facade-thumb{width:100%;height:100%;object-fit:cover;display:block;}
.yt-facade-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:72px;height:72px;border-radius:50%;background:var(--yellow);display:flex;align-items:center;justify-content:center;box-shadow:0 14px 34px rgba(0,0,0,.45);transition:transform .25s var(--ease);}
.yt-facade:hover .yt-facade-play{transform:translate(-50%,-50%) scale(1.08);}
.video-placeholder{
  position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;
  color:var(--white);
}
.play-btn{
  width:84px;height:84px;border-radius:50%;background:var(--yellow);
  display:flex;align-items:center;justify-content:center;color:var(--blue-deep);
  transition:transform .3s var(--ease);box-shadow:0 14px 34px rgba(249,218,73,.35);
}
.video-shell:hover .play-btn{transform:scale(1.08);}
.video-placeholder span{font-family:var(--label);font-size:14px;letter-spacing:.05em;color:rgba(255,255,255,.65);}

/* ===================== FOOTER ===================== */
.footer{background:var(--blue-deep);color:rgba(255,255,255,.72);padding:70px 0 30px;}
.footer-top{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:50px;padding-bottom:46px;border-bottom:1px solid rgba(255,255,255,.12);}
.footer-logo img{height:56px;width:auto;margin-bottom:16px;filter:brightness(0) invert(1);}
.footer-top p{font-size:14.5px;line-height:1.6;max-width:320px;}
.footer-col h4{font-family:var(--label);font-size:15px;letter-spacing:.05em;text-transform:uppercase;color:var(--white);margin-bottom:18px;}
.footer-col ul li{margin-bottom:11px;}
.footer-col a{font-size:14.5px;transition:color .25s var(--ease);}
.footer-col a:hover{color:var(--yellow);}
.footer-social{display:flex;gap:12px;margin-top:6px;}
.footer-social a{
  width:38px;height:38px;border-radius:50%;border:1px solid rgba(255,255,255,.25);
  display:flex;align-items:center;justify-content:center;transition:.3s var(--ease);
}
.footer-social a:hover{background:var(--yellow);border-color:var(--yellow);color:var(--blue-deep);transform:translateY(-3px);}
.footer-bottom{display:flex;justify-content:space-between;align-items:center;padding-top:26px;font-size:13px;flex-wrap:wrap;gap:12px;}
@media (max-width:800px){.footer-top{grid-template-columns:1fr;gap:34px;}.footer-bottom{flex-direction:column;text-align:center;}}

/* small helpers */
.text-center{text-align:center;margin-left:auto;margin-right:auto;}
.badge-note{
  display:inline-block;margin-top:10px;font-size:12px;color:#b7bfd0;font-style:italic;
}
</style>
</head>
<body>
<script>
if (location.hash && /confirmation_token|invite_token|recovery_token|email_change_token/.test(location.hash)) {
  location.href = '/admin/' + location.hash;
}
</script>

<!-- ============ NAV ============ -->
<header class="nav" id="siteNav">
  <div class="wrap">
    <a href="#hero" class="nav-logo">
      <img src="data:image/png;base64," alt="Tião Medeiros — Deputado Federal">
    </a>
    <nav class="nav-links" id="navLinks">
      <a href="#sobre">Sobre</a>
      <a href="#trajetoria">Trajetória</a>
      <a href="#obras">Obras</a>
      <a href="#pautas">Pautas</a>
      <a href="#projetos">Projetos</a>
      <a href="#video">Vídeo</a>
      <a href="#contato" class="nav-cta">Fale com o gabinete</a>
    </nav>
    <button class="nav-toggle" id="navToggle" aria-label="Abrir menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<!-- ============ HERO ============ -->
<section class="hero" id="hero">
  <div class="hero-bg-pattern"></div>
  <div class="hero-sash"></div>
  <div class="wrap">
    <div class="hero-copy">
      <div class="hero-eyebrow-row reveal in">
        <span class="eyebrow on-dark">{{ site.hero.eyebrow }}</span>
      </div>
      <h1 class="reveal in reveal-d1">{{ site.hero.title_html | safe }}</h1>
      <p class="lead reveal in reveal-d2">{{ site.hero.lead }}</p>
    </div>
    <div class="hero-photo-frame reveal in reveal-d2">
      <div class="hero-photo-accent" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><path d="M12 2l2.4 7.2H22l-6 4.4 2.3 7.2L12 16.4l-6.3 4.4L8 13.6 2 9.2h7.6L12 2z" fill="#0f2350"/></svg>
      </div>
      <div class="hero-photo-card">
        {% if site.video.youtube_id %}
        <button type="button" class="yt-facade" data-yt-id="{{ site.video.youtube_id }}" aria-label="Reproduzir vídeo: Conheça Tião Medeiros">
          <img class="yt-facade-thumb" src="https://img.youtube.com/vi/{{ site.video.youtube_id }}/maxresdefault.jpg" onerror="this.onerror=null;this.src='https://img.youtube.com/vi/{{ site.video.youtube_id }}/hqdefault.jpg';" alt="Capa do vídeo: Conheça Tião Medeiros">
          <span class="yt-facade-play"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M8 5v14l11-7-11-7z" fill="#0f2350"/></svg></span>
        </button>
        {% else %}
        <div class="hero-video-placeholder">
          <div class="play-btn"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M8 5v14l11-7-11-7z" fill="currentColor"/></svg></div>
          <span>{{ site.video.placeholder_text }}</span>
        </div>
        {% endif %}
      </div>
    </div>
    <div class="hero-trust reveal in reveal-d4">
      <div class="flag-pin" title="Brasil" aria-hidden="true">
        <svg viewBox="0 0 100 100" width="40" height="40">
          <rect width="100" height="100" fill="#2f9e44"/>
          <polygon points="50,14 90,50 50,86 10,50" fill="#f9da49"/>
          <circle cx="50" cy="50" r="18" fill="#274994"/>
        </svg>
      </div>
      <div class="flag-pin" title="Paraná" aria-hidden="true">
        <svg viewBox="0 0 100 100" width="40" height="40">
          <rect width="100" height="100" fill="#2f9e44"/>
          <path d="M0 20 L100 60 L100 78 L0 38 Z" fill="#ffffff"/>
          <circle cx="50" cy="46" r="16" fill="#274994"/>
        </svg>
      </div>
      <div class="hero-trust-text">{{ site.hero.trust_text }}<strong>{{ site.hero.trust_strong }}</strong></div>
      <div class="trust-divider"></div>
      <div class="legisla-chip"><span class="dot"></span> {{ site.hero.legisla_chip }}</div>
    </div>
  </div>
  <div class="scroll-cue" aria-hidden="true"><span>Role</span><div class="line"></div></div>
</section>

<!-- ============ SOBRE ============ -->
<section class="section" id="sobre">
  <div class="wrap">
    <div class="about-grid">
      <div class="about-photo reveal">
        {% if site.about.photo %}
        <img src="{{ site.about.photo }}" alt="Tião Medeiros" style="width:100%;height:100%;object-fit:cover;">
        {% else %}
        <svg class="ph-icon" viewBox="0 0 24 24" fill="none"><path d="M12 12a5 5 0 100-10 5 5 0 000 10zM4 22c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round"/></svg>
        {% endif %}
      </div>
      <div class="about-text reveal reveal-d1">
        <span class="eyebrow">{{ site.about.eyebrow }}</span>
        <h2 style="font-size:clamp(26px,3.2vw,36px);font-weight:800;margin:16px 0 22px;line-height:1.2;">{{ site.about.title }}</h2>
        {% for para in site.about.paragraphs %}
        <p>{{ para }}</p>
        {% endfor %}
        <div class="about-badges">
          {% for badge in site.about.badges %}
          <span class="about-badge">{{ badge }}</span>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ TRAJETÓRIA / TIMELINE ============ -->
<section class="section section-paper" id="trajetoria">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Trajetória</span>
      <h2>Uma trajetória construída passo a passo.</h2>
      <p>Da vida pública em Paranavaí à Câmara dos Deputados, cada etapa somou experiência e resultado para o Paraná.</p>
    </div>
    <div class="timeline-scroll reveal reveal-d1 at-start" id="timelineScroll">
      <button class="tl-nav tl-nav-prev" id="tlPrev" type="button" aria-label="Momento anterior">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="tl-viewport">
        <div class="timeline" id="timelineTrack">
          {% for t in timeline.timeline %}
          <div class="tl-item" data-tl-target="{{ t.num }}" role="button" tabindex="0">
            <div class="tl-media">
              {% if t.photo %}
              <img class="slot-img" src="{{ t.photo }}" alt="{{ t.title }}">
              {% else %}
              <div class="slot-content"><svg class="ph-icon" viewBox="0 0 24 24" fill="none"><path d="M12 12a5 5 0 100-10 5 5 0 000 10zM4 22c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round"/></svg></div>
              {% endif %}
            </div>
            <div class="tl-body"><div class="tl-num">{{ t.num }}</div><div class="tl-title">{{ t.title }}</div></div>
          </div>
          {% endfor %}
        </div>
      </div>
      <button class="tl-nav tl-nav-next" id="tlNext" type="button" aria-label="Próximo momento">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
    <div class="tl-progress"><div class="tl-progress-fill" id="tlProgressFill"></div></div>
    <p class="badge-note">Arraste ou use as setas para ver toda a linha do tempo →</p>
  </div>

  <!-- ============ MODAL TRAJETÓRIA ============ -->
  <div class="pauta-modal-overlay" id="tlModalOverlay" aria-hidden="true">
    {% for t in timeline.timeline %}
    <div class="pauta-modal-panel" data-tl-panel="{{ t.num }}">
      <button class="pauta-modal-close" type="button" data-tl-modal-close aria-label="Fechar">×</button>
      <div class="pauta-modal-photo">
        {% if t.photo %}
        <img src="{{ t.photo }}" alt="{{ t.title }}" style="width:100%;height:100%;object-fit:cover;">
        {% else %}
        <div class="slot-content"><svg class="ph-icon" viewBox="0 0 24 24" fill="none"><path d="M12 12a5 5 0 100-10 5 5 0 000 10zM4 22c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round"/></svg></div>
        {% endif %}
      </div>
      <div class="pauta-modal-body">
        <span class="eyebrow">Trajetória — {{ t.num }}</span>
        <h3>{{ t.title }}</h3>
        {% for para in t.body %}
        <p>{{ para }}</p>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<!-- ============ GRANDES OBRAS ============ -->
<section class="section" id="obras">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Grandes obras e entregas</span>
      <h2>Resultados que o Paraná pode ver e sentir.</h2>
      <p>Espaço reservado para fotos, vídeos e números das entregas do mandato. Conteúdo a ser publicado em breve.</p>
    </div>
    <div class="stats-row reveal reveal-d1">
      <div class="stat-card"><div class="stat-num">—</div><div class="stat-label">Municípios beneficiados</div><div class="stat-placeholder">dado a inserir</div></div>
      <div class="stat-card"><div class="stat-num">—</div><div class="stat-label">Valor investido</div><div class="stat-placeholder">dado a inserir</div></div>
      <div class="stat-card"><div class="stat-num">—</div><div class="stat-label">Projetos entregues</div><div class="stat-placeholder">dado a inserir</div></div>
    </div>
    <div class="obras-grid reveal reveal-d2">
      <div class="obra-card">
        <div class="obra-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 9l9-6 9 6v11a1 1 0 01-1 1H4a1 1 0 01-1-1V9z" stroke="currentColor" stroke-width="1.5"/></svg></div>
        <h3>Obra ou entrega</h3><p>Foto e descrição a inserir</p>
      </div>
      <div class="obra-card">
        <div class="obra-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div>
        <h3>Indicador de resultado</h3><p>Número e fonte a inserir</p>
      </div>
      <div class="obra-card">
        <div class="obra-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/></svg></div>
        <h3>Vídeo ou galeria</h3><p>Material a inserir</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ PAUTAS E VALORES ============ -->
<section class="section section-paper" id="pautas">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Pautas e valores</span>
      <h2>O que orienta cada decisão do mandato.</h2>
    </div>
    <div class="pautas-grid">
      {% for p in pautas.pautas %}
      <div class="pauta-card reveal" data-pauta-target="{{ p.id }}" role="button" tabindex="0">
        <div class="pauta-icon">{% if p.icon == "agro" %}<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 21V9M12 9c0-2.5-1.8-4.5-4-5 .3 2.5 1.4 4.3 4 5zm0 0c0-2.5 1.8-4.5 4-5-.3 2.5-1.4 4.3-4 5zm0 4c0-2.2-1.6-4-3.6-4.4.3 2.2 1.3 3.8 3.6 4.4zm0 0c0-2.2 1.6-4 3.6-4.4-.3 2.2-1.3 3.8-3.6 4.4z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>{% elif p.icon == "familia" %}<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 21s-7-4.4-9.5-8.8C1 8.7 2.7 5 6.3 5c2 0 3.4 1.2 4.2 2.4C11.3 6.2 12.7 5 14.7 5c3.6 0 5.3 3.7 3.8 7.2C20 16.6 12 21 12 21z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>{% elif p.icon == "empreendedorismo" %}<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M3 21V9l9-6 9 6v12M9 21v-6h6v6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>{% else %}<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 2l8 3.5v6c0 5-3.4 8.8-8 10.5-4.6-1.7-8-5.5-8-10.5v-6L12 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>{% endif %}</div>
        <h3>{{ p.title }}</h3>
        <p>{{ p.summary }}</p>
        <span class="pauta-more">Saiba mais <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </div>
      {% endfor %}
    </div>
  </div>

  <!-- ============ MODAL PAUTAS E VALORES ============ -->
  <div class="pauta-modal-overlay" id="pautaModalOverlay" aria-hidden="true">
    {% for p in pautas.pautas %}
    <div class="pauta-modal-panel" data-pauta-panel="{{ p.id }}">
      <button class="pauta-modal-close" type="button" data-modal-close aria-label="Fechar">×</button>
      <div class="pauta-modal-photo">
        {% if p.photo %}
        <img src="{{ p.photo }}" alt="{{ p.title }}" style="width:100%;height:100%;object-fit:cover;">
        {% else %}
        <div class="slot-content"><svg class="ph-icon" viewBox="0 0 24 24" fill="none"><path d="M12 12a5 5 0 100-10 5 5 0 000 10zM4 22c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round"/></svg></div>
        {% endif %}
      </div>
      <div class="pauta-modal-body">
        <span class="eyebrow">Pautas e valores</span>
        <h3>{{ p.title }}</h3>
        {% for para in p.body %}
        <p>{{ para }}</p>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<!-- ============ PROJETOS LEGISLATIVOS ============ -->
<section class="section" id="projetos">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Projetos legislativos</span>
      <h2>Propostas que tramitam pelo Paraná.</h2>
      <p>Projetos de autoria e de relatoria. Quando o card traz o selo <strong>Relator</strong>, Tião Medeiros foi o relator da proposta na Câmara — não o autor.</p>
    </div>
    <div class="projetos-grid">
      {% for proj in projetos.projetos %}
      <div class="projeto-card{% if proj.wide %} projeto-card--wide{% endif %}" data-relator="{{ proj.relator }}">
        <div class="projeto-top"><span class="projeto-tag">{{ proj.tag }}</span><span class="relator-seal">Relator</span></div>
        <h3>{{ proj.title }}</h3>
        <p>{{ proj.body }}</p>
        <a href="{{ proj.link }}" class="projeto-link">Saber mais <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ============ RECONHECIMENTO ============ -->
<section class="section section-paper" id="reconhecimento">
  <div class="wrap">
    <div class="reco reveal">
      <div class="reco-medal">
        <div class="reco-medal-inner"><span class="big">{{ site.reconhecimento.medal_big }}</span><span class="small">{{ site.reconhecimento.medal_small }}</span></div>
      </div>
      <div>
        <span class="eyebrow on-dark">Reconhecimento</span>
        <h2 style="margin-top:14px;">{{ site.reconhecimento.title }}</h2>
        <p>{{ site.reconhecimento.text }}</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ VÍDEO ============ -->
<section class="section" id="video">
  <div class="wrap">
    <div class="section-head text-center reveal">
      <span class="eyebrow" style="justify-content:center;">Vídeo</span>
      <h2>Conheça Tião Medeiros</h2>
    </div>
    <div class="video-shell reveal reveal-d1">
      {% if site.video.youtube_id %}
      <button type="button" class="yt-facade" data-yt-id="{{ site.video.youtube_id }}" aria-label="Reproduzir vídeo: Conheça Tião Medeiros">
          <img class="yt-facade-thumb" src="https://img.youtube.com/vi/{{ site.video.youtube_id }}/maxresdefault.jpg" onerror="this.onerror=null;this.src='https://img.youtube.com/vi/{{ site.video.youtube_id }}/hqdefault.jpg';" alt="Capa do vídeo: Conheça Tião Medeiros">
          <span class="yt-facade-play"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M8 5v14l11-7-11-7z" fill="#0f2350"/></svg></span>
        </button>
      {% else %}
      <div class="video-placeholder">
        <div class="play-btn"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M8 5v14l11-7-11-7z" fill="currentColor"/></svg></div>
        <span>{{ site.video.placeholder_text }}</span>
      </div>
      {% endif %}
